[Unit]
Description=Equipment Inventory Streamlit admin
After=network.target equipment-inventory-api.service

[Service]
Type=simple
WorkingDirectory=/opt/equipment_inventory
EnvironmentFile=/opt/equipment_inventory/.env
ExecStart=/opt/equipment_inventory/.venv/bin/streamlit run pc_admin/admin.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=always
RestartSec=5
User=inventory
Group=inventory

[Install]
WantedBy=multi-user.target
