# Copy to .env.runtime beside the released compose.yaml; never upload the filled file.
# Use a fixed random secret of at least 32 characters and your own password (12-128).
INVENTORY_SECRET_KEY=
INVENTORY_ADMIN_PASSWORD=

# Required only for real WeChat login. Use the recipient's own approved configuration.
WECHAT_APPID=
WECHAT_SECRET=

# Optional AI configuration. Ordinary inventory and comparisons work without a model key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

# Set to the actual HTTPS URL when using public QR links / a real deployment.
INVENTORY_PUBLIC_BASE_URL=

# Standalone container: account/password protection; compose publishes localhost only.
# Internet publication requires HTTPS and an approved access gateway; see README.
INVENTORY_ENV=production
INVENTORY_DEV_LOGIN=0
INVENTORY_ALLOW_LOGIN_REQUESTS=0
INVENTORY_REMOTE_ADMIN_ENABLED=0
INVENTORY_ADMIN_IP_RESTRICTION_ENABLED=0
INVENTORY_LOGIN_RATE_LIMIT_ENABLED=1
INVENTORY_TOKEN_TTL_SECONDS=7200
INVENTORY_BACKUP_KEEP=10
