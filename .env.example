# Copy this file to .env and fill local secrets.
# .env is ignored by git and should not be committed.

# Backend security
INVENTORY_SECRET_KEY=replace-with-at-least-32-random-chars
INVENTORY_ADMIN_PASSWORD=replace-with-your-admin-password
INVENTORY_DEV_LOGIN=0
INVENTORY_ALLOW_LOGIN_REQUESTS=0
INVENTORY_LOGIN_RATE_LIMIT_ENABLED=1
INVENTORY_ADMIN_LOGIN_RATE_LIMIT=5
INVENTORY_WORKER_LOGIN_RATE_LIMIT=30
INVENTORY_LOGIN_RATE_WINDOW_SECONDS=60
# Keep the admin API local by default. Add fixed trusted IPs/CIDRs only when needed.
INVENTORY_ADMIN_IP_RESTRICTION_ENABLED=1
INVENTORY_ADMIN_ALLOWED_IPS=127.0.0.1,::1
INVENTORY_TRUSTED_PROXY_IPS=127.0.0.1,::1
INVENTORY_TOKEN_TTL_SECONDS=7200
INVENTORY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Stable URL prefix encoded into asset QR images.
INVENTORY_PUBLIC_BASE_URL=http://127.0.0.1:8000

# WeChat Mini Program login. Required for production/public access.
WECHAT_APPID=replace-with-your-wechat-miniprogram-appid
WECHAT_SECRET=replace-with-your-wechat-miniprogram-secret

# DeepSeek API for AI 模型分析
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=your-deepseek-model-name
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: use standalone local agent service instead of direct backend -> DeepSeek calls.
# INVENTORY_AI_AGENT_URL=http://127.0.0.1:9000/analyze
# INVENTORY_AGENT_TOKEN=replace-with-at-least-24-random-chars
