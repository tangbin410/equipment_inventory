<!-- 任务列表页 -->

<view class="page">
  <!-- 用户信息栏 -->
  <view class="user-bar">
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-role">现场人员 · {{areaName}}</text>
    </view>
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 任务统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{totalTasks}}</text>
      <text class="stat-label">全部</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{doingTasks}}</text>
      <text class="stat-label">盘点中</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{doneTasks}}</text>
      <text class="stat-label">完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-num warn">{{unscannedTotal}}</text>
      <text class="stat-label">未扫</text>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="filter-bar">
    <input class="search-input" placeholder="搜索机房或任务" bindinput="onKeywordInput" />
    <picker mode="selector" range="{{statusOptions}}" bindchange="onStatusChange">
      <view class="filter-picker">筛选状态</view>
    </picker>
  </view>
  <view class="section-title">盘点任务</view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{_tasksEmpty}}" class="empty">
    <text>暂无我的任务，请先到【领任务】领取机房</text>
  </view>

  <view wx:else class="task-list">
    <view
      class="task-card card"
      wx:for="{{tasks}}"
      wx:key="id"
      bindtap="openTask"
      data-id="{{item.id}}"
    >
      <!-- 任务头部 -->
      <view class="task-header">
        <view class="task-title-row">
          <view class="status-dot {{item._dotClass}}"></view>
          <text class="task-name">{{item.task_name}}</text>
        </view>
        <view class="task-status">
          <text class="tag {{item._tagCls}}">
            {{item._statusTag}}
          </text>
        </view>
      </view>

      <!-- 机房 -->
      <view class="task-room">📍 {{item.room_name}}</view>
      <view class="task-meta-row">
        <text class="task-meta">未扫 {{item._unscanned}}</text>
        <text class="task-meta warn">异常 {{item._mismatch}}</text>
        <text class="task-action" data-id="{{item.id}}" catchtap="openTask">{{item._actionText}}</text>
        <text wx:if="{{item._canRelease}}" class="release-action" data-id="{{item.id}}" catchtap="releaseTask">释放任务</text>
      </view>

      <!-- 进度条 -->
      <view class="progress-row">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item._progressPct}}%"></view>
        </view>
        <text class="progress-text">{{item.scanned}}/{{item.total}}</text>
      </view>
    </view>
  </view>
</view>
