<!-- 任务列表页 -->

<view class="page">
  <!-- 用户信息栏 -->
  <view class="user-bar">
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-role">现场人员 · {{areaName}}</text>
    </view>
    <button class="back-btn" bindtap="goBack">返回上级</button>
  </view>

  <!-- 任务统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{totalTasks}}</text>
      <text class="stat-label">{{mode === 'completed' ? '已完成任务' : '待完成任务'}}</text>
    </view>
    <view wx:if="{{mode !== 'completed'}}" class="stat-item">
      <text class="stat-num">{{pendingTasks}}</text>
      <text class="stat-label">未开始</text>
    </view>
    <view wx:if="{{mode !== 'completed'}}" class="stat-item">
      <text class="stat-num">{{doingTasks}}</text>
      <text class="stat-label">盘点中</text>
    </view>
    <view wx:if="{{mode === 'completed'}}" class="stat-item">
      <text class="stat-num">{{scannedTotal}}</text>
      <text class="stat-label">已处理设备</text>
    </view>
    <view wx:if="{{mode !== 'completed'}}" class="stat-item">
      <text class="stat-num warn">{{unscannedTotal}}</text>
      <text class="stat-label">未处理</text>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="filter-bar">
    <input class="search-input" value="{{keyword}}" placeholder="搜索机房或任务" bindinput="onKeywordInput" />
  </view>
  <view class="section-title">{{pageTitle}}</view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{_tasksEmpty}}" class="empty">
    <text wx:if="{{keyword}}">未找到匹配的机房或任务</text>
    <text wx:elif="{{mode === 'completed'}}">暂无本人已完成的盘点任务</text>
    <text wx:else>暂无待完成任务，请先到【领任务】领取机房</text>
  </view>

  <view wx:else class="task-list">
    <view
      class="task-card card"
      wx:for="{{tasks}}"
      wx:key="id"
      bindtap="openTask"
      data-id="{{item.id}}"
    >
      <!-- 任务头部 -->
      <view class="task-header">
        <view class="task-title-row">
          <view class="status-dot {{item._dotClass}}"></view>
          <text class="task-name">{{item.task_name}}</text>
        </view>
        <view class="task-status">
          <text class="tag {{item._tagCls}}">{{item._statusTag}}</text>
        </view>
      </view>

      <!-- 机房 -->
      <view class="task-room">📍 {{item.room_name}}</view>
      <view wx:if="{{item.superseded_by_task_id}}" class="replacement-notice">该机房有最新任务 #{{item.superseded_by_task_id}}，请释放当前任务并领取最新任务。当前任务仅可查看。</view>
      <view wx:if="{{mode === 'completed'}}" class="completed-time">完成时间：{{item._completedAt || '未记录'}}</view>
      <view class="task-meta-row">
        <text wx:if="{{mode !== 'completed'}}" class="task-meta">未处理 {{item._unscanned}}</text>
        <text class="task-meta warn">异常 {{item._mismatch}}</text>
        <view class="task-actions">
          <text class="task-action" data-id="{{item.id}}" catchtap="openTask">{{item._actionText}}</text>
          <text wx:if="{{item._canRelease}}" class="release-action" data-id="{{item.id}}" catchtap="releaseTask">{{releasingTaskId == item.id ? '释放中' : item.superseded_by_task_id ? '释放并前往' : '释放任务'}}</text>
        </view>
      </view>

      <!-- 进度条 -->
      <view class="progress-row">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item._progressPct}}%"></view>
        </view>
        <text class="progress-text">{{item.scanned}}/{{item.total}}</text>
      </view>
    </view>
  </view>
</view>
