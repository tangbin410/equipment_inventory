<view class="page">
  <view class="user-bar">
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-role">整改任务 · {{areaName}}</text>
    </view>
    <button class="back-btn" bindtap="goBack">返回上级</button>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">全部</text>
    </view>
    <view class="stat-item">
      <text class="stat-num warn">{{pendingCount}}</text>
      <text class="stat-label">待整改</text>
    </view>
    <view class="stat-item">
      <text class="stat-num warn">{{verifyCount}}</text>
      <text class="stat-label">待验收</text>
    </view>
    <view class="stat-item">
      <text class="stat-num done">{{doneCount}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <view class="section-title">资产整改闭环</view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{empty}}" class="empty">
    <text>暂无管理员下发的整改任务</text>
  </view>

  <view wx:else class="task-list">
    <view class="task-card card" wx:for="{{tasks}}" wx:key="id">
      <view class="task-header">
        <view class="task-title-row">
          <view class="status-dot"></view>
          <text class="task-name">{{item._problemTitle}}</text>
        </view>
        <view class="task-status">
          <text class="tag {{item._statusCls}}">{{item._statusText}}</text>
        </view>
      </view>

      <view class="task-room">📍 {{item._roomText}}</view>
      <view class="task-meta-row">
        <text class="task-meta">风险 {{item._riskText}}</text>
        <text class="task-meta warn">优先级 {{item._priorityText}}</text>
      </view>
      <view class="field-block">
        <text class="field-label">涉及设备</text>
        <text class="field-text">{{item._deviceText}}</text>
      </view>
      <view class="field-block">
        <text class="field-label">整改建议</text>
        <text class="field-text">{{item._suggestionText}}</text>
      </view>
      <view class="field-block">
        <text class="field-label">判断依据</text>
        <text class="field-text">{{item._basisText}}</text>
      </view>

      <view wx:if="{{item._hasReminder}}" class="reminder-block">
        <text class="reminder-title">{{item._reminderSummary}}</text>
        <text class="reminder-note">{{item._reminderNote}}</text>
      </view>

      <view wx:if="{{item._canComplete}}" class="field-block">
        <text class="field-label">审核要求</text><text class="field-text">{{item.review_note || '按整改建议处理'}}</text>
        <text class="field-label">整改结果说明（必填）</text>
        <textarea class="feedback-input" placeholder="填写实际处理情况和核实依据" maxlength="1500" data-index="{{index}}" bindinput="inputFeedback" />
        <view wx:if="{{item.needs_new_feedback}}" class="feedback-record">
          <text class="field-label">本单暂无现场记录，可补充本设备反馈 · {{item.target_room}}</text>
          <input class="feedback-input" placeholder="现场新增设备名称" data-index="{{index}}" data-field="device_name" bindinput="inputNewFeedback" />
          <input class="feedback-input" placeholder="实际资产条码" data-index="{{index}}" data-field="asset_barcodes" bindinput="inputNewFeedback" />
          <input class="feedback-input" placeholder="实际型号" data-index="{{index}}" data-field="actual_model" bindinput="inputNewFeedback" />
          <input class="feedback-input" placeholder="机柜条码" data-index="{{index}}" data-field="cabinet_barcodes" bindinput="inputNewFeedback" />
          <view>无机柜条码 <switch data-index="{{index}}" data-field="cabinet_no_barcode" bindchange="inputNewFeedback" /></view>
          <input class="feedback-input" placeholder="机架号" data-index="{{index}}" data-field="rack_no" bindinput="inputNewFeedback" />
        </view>
        <text wx:if="{{item.field_records.length}}" class="field-label">需要更新条码或型号时，仅修改本单设备反馈</text>
        <view wx:for="{{item.field_records}}" wx:for-item="record" wx:for-index="recordindex" wx:key="id" class="feedback-record">
          <text>{{record.device_name}} · 记录 #{{record.id}}</text>
          <input class="feedback-input" value="{{record.asset_barcodes}}" placeholder="实际资产条码" data-index="{{index}}" data-recordindex="{{recordindex}}" data-field="asset_barcodes" bindinput="editFeedbackRecord" />
          <input class="feedback-input" value="{{record.actual_model}}" placeholder="整改后的实际型号" data-index="{{index}}" data-recordindex="{{recordindex}}" data-field="actual_model" bindinput="editFeedbackRecord" />
          <input class="feedback-input" value="{{record.cabinet_barcodes}}" disabled="{{record.cabinet_no_barcode}}" placeholder="实际机柜条码" data-index="{{index}}" data-recordindex="{{recordindex}}" data-field="cabinet_barcodes" bindinput="editFeedbackRecord" />
          <view>无机柜条码 <switch checked="{{record.cabinet_no_barcode}}" data-index="{{index}}" data-recordindex="{{recordindex}}" bindchange="toggleCabinetMissing" /></view>
          <input class="feedback-input" value="{{record.rack_no}}" placeholder="实际机架号" data-index="{{index}}" data-recordindex="{{recordindex}}" data-field="rack_no" bindinput="editFeedbackRecord" />
        </view>
      </view>
      <button
        wx:if="{{item._canComplete}}"
        class="complete-btn"
        data-id="{{item.id}}"
        catchtap="completeTask"
      >
        确认整改完成
      </button>
      <view wx:else class="done-tip">{{item._tipText}}</view>
    </view>
  </view>
</view>
