/* 整改任务页样式 */
.page {
  min-height: 100vh;
  padding-bottom: 24px;
  background: #f4f7fb;
}

.user-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #1677ff, #3d8bff);
  padding: 20px 16px 32px;
  color: #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 18px;
  font-weight: 600;
}

.user-role {
  font-size: 12px;
  opacity: 0.75;
  margin-top: 2px;
}

.back-btn {
  background: rgba(255,255,255,0.2);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.4);
  border-radius: 999px;
  padding: 5px 14px;
  font-size: 12px;
  line-height: 1.8;
}

.back-btn:active {
  background: rgba(255,255,255,0.35);
}

.stats-row {
  display: flex;
  background: #fff;
  margin: 0 12px;
  border-radius: 14px;
  padding: 16px 0;
  margin-top: -18px;
  box-shadow: 0 8px 22px rgba(31,45,61,0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 26px;
  font-weight: 600;
  color: #1a1a1a;
}

.stat-num.warn {
  color: #d97706;
}

.stat-num.done {
  color: #12a46f;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: #1f2d3d;
  padding: 18px 14px 8px;
}

.filter-bar { display: flex; padding: 16px 12px 0; }
.search-input { flex: 1; height: 40px; box-sizing: border-box; padding: 0 12px; background: #fff; border: 1px solid #d9e7f7; border-radius: 10px; font-size: 14px; }
.filter-picker { height: 40px; line-height: 40px; padding: 0 13px; background: #fff; border: 1px solid #d9e7f7; border-radius: 10px; color: #49637e; font-size: 13px; }
.filter-bar picker { margin-left: 8px; }

.task-list {
  padding: 0 0 16px;
}

.task-card {
  margin-bottom: 10px;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(31,45,61,0.06);
}

.task-card:active {
  background: #fafafa;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.task-title-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 15px;
  font-weight: 600;
  color: #1f2d3d;
  flex: 1;
  line-height: 1.35;
}

.task-status {
  flex-shrink: 0;
  margin-left: 8px;
}

.task-status .tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 58px;
  height: 28px;
  line-height: 1;
  margin: 0;
  padding: 0 10px;
  border-radius: 999px;
  text-align: center;
  font-size: 12px;
  font-weight: 700;
  box-sizing: border-box;
  white-space: nowrap;
}

.tag-doing {
  color: #1677ff;
  border-color: #b7d7ff;
  background: #eef6ff;
}

.tag-success {
  color: #12a46f;
  border-color: #c9f2df;
  background: #effcf5;
}

.status-dot {
  width: 8px;
  height: 8px;
  margin-right: 8px;
  border-radius: 50%;
  background: #18c5c8;
  box-shadow: 0 0 0 5px rgba(24, 197, 200, 0.12);
}

.task-room {
  font-size: 13px;
  color: #6b7c90;
  margin-bottom: 8px;
}

.task-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.task-meta {
  font-size: 12px;
  color: #50657d;
  background: #f4f7fb;
  border-radius: 999px;
  padding: 3px 9px;
  margin-right: 8px;
}

.task-meta.warn {
  color: #d97706;
  background: #fff7e6;
}

.field-block {
  margin-top: 10px;
  padding: 10px;
  border-radius: 10px;
  background: #f7fbff;
}

.field-label,
.field-text {
  display: block;
}

.field-label {
  margin-bottom: 5px;
  color: #6b7c90;
  font-size: 12px;
}

.field-text {
  color: #1f2d3d;
  font-size: 13px;
  line-height: 1.55;
}

.reminder-block {
  margin-top: 12px;
  padding: 11px 12px;
  border-left: 4px solid #d94841;
  border-radius: 8px;
  background: #fff3f2;
}

.reminder-title,
.reminder-note {
  display: block;
}

.reminder-title {
  color: #b42318;
  font-size: 13px;
  font-weight: 700;
}

.reminder-note {
  margin-top: 5px;
  color: #6f332f;
  font-size: 13px;
  line-height: 1.5;
}

.complete-btn {
  margin-top: 12px;
  height: 40px;
  line-height: 40px;
  border-radius: 999px;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  background: linear-gradient(135deg, #1677ff, #18c5c8);
  box-shadow: 0 8px 16px rgba(22, 119, 255, 0.16);
}

.done-tip {
  margin-top: 12px;
  padding: 10px;
  border-radius: 10px;
  color: #12a46f;
  font-size: 13px;
  text-align: center;
  background: #effcf5;
}

.task-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 150px;
}

.task-action {
  margin-left: auto;
  min-width: 72px;
  height: 30px;
  line-height: 30px;
  box-sizing: border-box;
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #1677ff, #3d8bff);
  border-radius: 999px;
  padding: 0 12px;
  box-shadow: 0 6px 12px rgba(22,119,255,0.18);
}

.release-action {
  margin-left: 8px;
  min-width: 72px;
  height: 30px;
  line-height: 30px;
  box-sizing: border-box;
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  color: #d64545;
  background: #fff7f7;
  border: 1px solid #ffd6d6;
  border-radius: 999px;
  padding: 0 12px;
}

.task-action:active {
  opacity: 0.86;
}

.release-action:active {
  background: #ffecec;
}

.progress-row {
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 7px;
  background: #edf2f7;
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1677ff, #69b1ff);
  border-radius: 999px;
  transition: width 0.3s;
}

.progress-text {
  font-size: 12px;
  color: #999;
  min-width: 40px;
  text-align: right;
  margin-left: 10px;
}

.loading, .empty {
  text-align: center;
  padding: 60px 0;
  color: #999;
  font-size: 14px;
}

.feedback-input {box-sizing:border-box;width:100%;min-height:72rpx;background:#f5f8fc;border:1rpx solid #dfe8f1;border-radius:8rpx;padding:16rpx;margin-top:12rpx;font-size:26rpx;}
.feedback-record {padding:18rpx 0;border-bottom:1rpx solid #edf1f5;}
