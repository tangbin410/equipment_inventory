.page {
  min-height: 100vh;
  padding: 12px;
  box-sizing: border-box;
  background: #f4f7fb;
}

.top-card {
  padding: 18px;
  border-radius: 18px;
  background: linear-gradient(135deg, #1677ff, #61a9ff);
  color: #fff;
  box-shadow: 0 10px 26px rgba(22, 119, 255, 0.18);
}

.title, .sub {
  display: block;
}

.title {
  font-size: 22px;
  font-weight: 700;
}

.sub {
  margin-top: 6px;
  font-size: 12px;
  opacity: 0.86;
}

.stats {
  display: flex;
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.stat {
  flex: 1;
}

.num {
  display: block;
  font-size: 24px;
  font-weight: 700;
}

.label {
  display: block;
  margin-top: 2px;
  font-size: 12px;
  opacity: 0.82;
}

.tabs {
  display: flex;
  margin: 14px 0 10px;
  padding: 4px;
  border-radius: 13px;
  background: #e9f1fb;
}

.tab {
  flex: 1;
  height: 34px;
  line-height: 34px;
  text-align: center;
  font-size: 13px;
  color: #55708c;
  border-radius: 10px;
}

.tab.active {
  color: #1677ff;
  font-weight: 700;
  background: #fff;
  box-shadow: 0 4px 12px rgba(31, 45, 61, 0.08);
}

.task-card {
  margin-bottom: 10px;
  padding: 15px;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 7px 20px rgba(31, 45, 61, 0.06);
}

.task-card.highlight { border: 1px solid #1677ff; }
.task-notice { display: block; margin-top: 8px; color: #ad6800; font-size: 12px; line-height: 1.6; }
.tag.waiting { width: auto; padding: 0 8px; color: #ad6800; background: #fff7e6; }

.card-head, .meta-row, .progress-row, .bottom-row {
  display: flex;
  align-items: center;
}

.card-head {
  justify-content: space-between;
  gap: 8px;
}

.room {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  font-weight: 700;
  color: #1f2d3d;
}

.task-name {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  color: #7b8da1;
}

.tag {
  flex-shrink: 0;
  width: 58px;
  height: 26px;
  line-height: 26px;
  padding: 0;
  border-radius: 999px;
  font-size: 12px;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.tag.pending {
  color: #1677ff;
  background: #eaf4ff;
}

.tag.doing {
  color: #d97706;
  background: #fff7e6;
}

.tag.done {
  color: #15945f;
  background: #e9f9f2;
}

.meta-row {
  margin-top: 10px;
}

.meta {
  margin-right: 8px;
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 12px;
  color: #50657d;
  background: #f4f7fb;
}

.meta.warn {
  color: #d97706;
  background: #fff7e6;
}

.progress-row {
  margin-top: 12px;
}

.progress-bar {
  flex: 1;
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #edf2f7;
}

.progress-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #1677ff, #69b1ff);
}

.progress-text {
  min-width: 48px;
  margin-left: 8px;
  text-align: right;
  font-size: 12px;
  color: #8a98a8;
}

.bottom-row {
  justify-content: space-between;
  margin-top: 12px;
}

.claimed {
  font-size: 12px;
  color: #7b8da1;
}

.claim-btn {
  margin: 0;
  padding: 0;
  width: 76px;
  height: 32px;
  line-height: 32px;
  border-radius: 999px;
  color: #fff;
  font-size: 13px;
  text-align: center;
  box-sizing: border-box;
  background: #1677ff;
}

.empty {
  padding: 60px 0;
  text-align: center;
  color: #8a98a8;
  font-size: 14px;
}
