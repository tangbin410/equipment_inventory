<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view>
        <text class="hello">你好，{{userName}}</text>
        <text class="area">所属片区：{{areaName}}</text>
      </view>
      <button class="logout-btn" bindtap="handleLogout">退出</button>
    </view>
    <text class="hero-title">机房资产盘点</text>
    <text class="hero-desc">先领取同片区机房任务，再进入我的任务开展扫码盘点。</text>
  </view>

  <view class="action-card" bindtap="goClaim">
    <view class="action-icon blue">领</view>
    <view class="action-main">
      <text class="action-title">领任务</text>
      <text class="action-desc">查看本片区待领取、盘点中、已完成机房</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="action-card" bindtap="goMyTasks">
    <view class="action-icon green">盘</view>
    <view class="action-main">
      <text class="action-title">我的任务</text>
      <text class="action-desc">继续扫码盘点，或释放当前领取任务</text>
    </view>
    <text class="arrow">›</text>
  </view>
</view>
